        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "lineWidth": 2
              },
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 10
                  },
                  {
                    "color": "red",
                    "value": 20
                  }
                ]
              }
            },
            "overrides": []
          },
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 12
          },
          "id": 115,
          "title": "Replication Latency \u2014 Time Behind (Standby)",
          "description": "End-to-end replication_latency (create->apply wall-clock) for tasks the standby applies from the active, p50 and p99. p99 = how many seconds the standby's applied data trails the active \u2014 the time-based handover-readiness signal, complementing the task-count Replication Lag panels. If p99 approaches 30s, tasks in flight when HANDOVER starts cannot drain within the 30s window and the handover rolls back. Red at 20s aligns with alert FAILOVER-PRE-07. See playbook section 1.3.",
          "type": "timeseries",
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "min",
                "max",
                "mean",
                "lastNotNull"
              ]
            }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, sum(rate(replication_latency_bucket{source_cluster=\"$active_cluster\"}[$__rate_interval])) by (le))",
              "legendFormat": "time behind p50",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.99, sum(rate(replication_latency_bucket{source_cluster=\"$active_cluster\"}[$__rate_interval])) by (le))",
              "legendFormat": "time behind p99",
              "refId": "B"
            }
          ]
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
