          "expr": "sum(catchup_ready_shard_count{target_cluster=\"$standby_cluster\"})",
          "legendFormat": "catchup ready",
          "refId": "A"
        },
        {
          "expr": "sum(handover_ready_shard_count{target_cluster=\"$standby_cluster\", namespace=\"$namespace\"})",
          "legendFormat": "handover ready",
          "refId": "B"
        },
        {
          "expr": "$total_shards + 0 * sum(catchup_ready_shard_count{target_cluster=\"$standby_cluster\"})",
          "legendFormat": "total_shards",
          "refId": "C"
        }
      ]
