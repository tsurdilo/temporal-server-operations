  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "expr": "handover_ready_shard_count{namespace=\"$namespace\"} > 0",
        "hide": false,
        "iconColor": "red",
        "name": "HANDOVER Active",
        "step": "15s",
        "titleFormat": "HANDOVER window open",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "expr": "increase(task_errors_version_mismatch{cluster=\"$active_cluster\"}[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "green",
        "name": "Flip Confirmed",
        "step": "15s",
        "titleFormat": "Flip confirmed \u2014 version fence fired",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
