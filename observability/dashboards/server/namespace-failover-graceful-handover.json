      "id": 201,
      "title": "Catchup Progress (%)",
      "description": "catchup_ready_shard_count{target_cluster=\"$standby_cluster\"} / $total_shards \u00d7 100. Rises during WaitReplication (Steps 1\u20133).\n\n\u26a0\ufe0f catchup_ready_shard_count has no namespace label until server PR merges \u2014 this panel aggregates all namespaces. See playbook section 2a.",
      "type": "gauge",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(catchup_ready_shard_count{target_cluster=\"$standby_cluster\"}) / $total_shards * 100",
          "legendFormat": "catchup %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_shards"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "handover ready"
            },
            "properties": [
