    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "expr": "increase(restarts{service_name=~\"matching\"}[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "red",
        "name": "Matching Restarts",
        "step": "60s",
        "tagKeys": "service_name",
